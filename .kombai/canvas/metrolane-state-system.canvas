class=\"h-3.5 w-3.5\" data-kid=\"1-2-2-2-3-2-1-2-1\" data-lucide=\"user\">\n                                </i>\n                            </button>\n                        </div>\n                        <div aria-live=\"polite\" class=\"border-b border-amber-200 bg-amber-50 px-3 py-2\" data-kid=\"1-2-2-2-3-2-2\" role=\"status\">\n                            <div class=\"flex items-start gap-2 text-[10px] text-amber-800\" data-kid=\"1-2-2-2-3-2-2-1\">\n                                <i class=\"mt-0.5 h-3.5 w-3.5 shrink-0\" data-kid=\"1-2-2-2-3-2-2-1-1\" data-lucide=\"wifi-off\">\n                                </i>\n                                <span data-kid=\"1-2-2-2-3-2-2-1-2\">\n                                    <strong class=\"font-semibold\" data-kid=\"1-2-2-2-3-2-2-1-2-1\">\n                                        Offline mode.\n                                    </strong>\n                                    Retry when online.\n                                </span>\n                            </div>\n                        </div>\n                        <div class=\"p-3\" data-kid=\"1-2-2-2-3-2-3\">\n                            <div class=\"flex items-center justify-between\" data-kid=\"1-2-2-2-3-2-3-1\">\n                                <div data-kid=\"1-2-2-2-3-2-3-1-1\">\n                                    <p class=\"text-[10px] font-semibold uppercase tracking-[.12em] text-orange-600\" data-kid=\"1-2-2-2-3-2-3-1-1-1\">\n                                        Result calculator\n                                    </p>\n                                    <h3 class=\"mt-1 text-base font-semibold text-gray-900\" data-kid=\"1-2-2-2-3-2-3-1-1-2\">\n                                        Generate result\n                                    </h3>\n                                </div>\n                                <span class=\"rounded-full bg-gray-100 px-2 py-1 text-[9px] font-medium text-gray-500\" data-kid=\"1-2-2-2-3-2-3-1-2\">\n                                    Step 1 of 2\n                                </span>\n                            </div>\n                            <div class=\"mt-3 rounded-lg border border-gray-200 bg-white p-3\" data-kid=\"1-2-2-2-3-2-3-2\" id=\"forms\">\n                                <div class=\"flex items-center justify-between\" data-kid=\"1-2-2-2-3-2-3-2-1\">\n                                    <h4 class=\"text-[10px] font-semibold text-gray-900\" data-kid=\"1-2-2-2-3-2-3-2-1-1\">\n                                        Student details\n                                    </h4>\n                                    <span class=\"text-[9px] text-red-600\" data-dynamic=\"true\" data-kid=\"1-2-2-2-3-2-3-2-1-2\" data-name=\"error count badge\" data-reason=\"text updated based on form validation state\">\n                                        2 errors\n                                    </span>\n                                </div>\n                                <label class=\"mt-3 block text-[9px] font-semibold text-gray-700\" data-kid=\"1-2-2-2-3-2-3-2-2\" for=\"mobile-name\">\n                                    Student name\n                                </label>\n                                <div class=\"relative mt-1\" data-kid=\"1-2-2-2-3-2-3-2-3\">\n                                    <input aria-describedby=\"mobile-name-error\" aria-invalid=\"true\" class=\"focus-ring h-8 w-full rounded-md border border-red-300 bg-red-50 px-2.5 text-[10px] text-gray-800 outline-none\" data-dynamic=\"true\" data-kid=\"1-2-2-2-3-2-3-2-3-1\" data-name=\"student name input field\" data-reason=\"value controlled by form state or user input\" id=\"mobile-name\" value=\"Amina Yusuf\"/>\n                                    <i class=\"pointer-events-none absolute right-2 top-1/2 h-3.5 w-3.5 -translate-y-1/2 text-red-600\" data-kid=\"1-2-2-2-3-2-3-2-3-2\" data-lucide=\"circle-alert\">\n                                    </i>\n                                </div>\n                                <p class=\"mt-1 text-[9px] text-red-700\" data-dynamic=\"true\" data-kid=\"1-2-2-2-3-2-3-2-4\" data-name=\"input error message\" data-reason=\"content updated by form validation script\" id=\"mobile-name-error\">\n                                    Use the full name from the student record.\n                                </p>\n                                <label class=\"mt-3 block text-[9px] font-semibold text-gray-700\" data-kid=\"1-2-2-2-3-2-3-2-5\" for=\"mobile-matric\">\n                                    Matric number\n                                </label>\n                                <input aria-describedby=\"mobile-matric-error\" aria-invalid=\"true\" class=\"focus-ring mt-1 h-8 w-full rounded-md border border-red-300 bg-red-50 px-2.5 text-[10px] text-gray-800 outline-none\" data-dynamic=\"true\" data-kid=\"1-2-2-2-3-2-3-2-6\" data-name=\"matric number input field\" data-reason=\"value controlled by form state or user input\" id=\"mobile-matric\" value=\"ML-2024-018\"/>\n                                <p class=\"mt-1 text-[9px] text-red-700\" data-dynamic=\"true\" data-kid=\"1-2-2-2-3-2-3-2-7\" data-name=\"matric error message\" data-reason=\"content updated by form validation script\" id=\"mobile-matric-error\">\n                                    Enter 10–12 characters.\n                                </p>\n                                <button class=\"focus-ring mt-3 flex h-9 w-full items-center justify-center gap-1.5 rounded-md bg-orange-500 text-[10px] font-semibold text-white\" data-kid=\"1-2-2-2-3-2-3-2-8\" type=\"button\">\n                                    <i class=\"h-3.5 w-3.5\" data-kid=\"1-2-2-2-3-2-3-2-8-1\" data-lucide=\"arrow-right\">\n                                    </i>\n                                    Continue\n                                </button>\n                            </div>\n                            <div class=\"mt-3 rounded-lg border border-orange-200 bg-orange-50 p-3\" data-kid=\"1-2-2-2-3-2-3-3\" role=\"alert\">\n                                <div class=\"flex gap-2\" data-kid=\"1-2-2-2-3-2-3-3-1\">\n                                    <i class=\"mt-0.5 h-3.5 w-3.5 shrink-0 text-orange-700\" data-kid=\"1-2-2-2-3-2-3-3-1-1\" data-lucide=\"lock-keyhole\">\n                                    </i>\n                                    <div data-kid=\"1-2-2-2-3-2-3-3-1-2\">\n                                        <p class=\"text-[10px] font-semibold text-orange-900\" data-kid=\"1-2-2-2-3-2-3-3-1-2-1\">\n                                            Session expired\n                                        </p>\n                                        <p class=\"mt-0.5 text-[9px] leading-4 text-orange-800\" data-kid=\"1-2-2-2-3-2-3-3-1-2-2\">\n                                            Sign in again to keep your draft.\n                                        </p>\n                                        <button class=\"focus-ring mt-2 rounded-md border border-orange-300 bg-white px-2 py-1 text-[9px] font-semibold text-orange-800\" data-kid=\"1-2-2-2-3-2-3-3-1-2-3\" type=\"button\">\n                                            Sign in\n                                        </button>\n                                    </div>\n                                </div>\n                            </div>\n                            <div aria-live=\"polite\" class=\"pointer-events-none relative mt-3\" data-kid=\"1-2-2-2-3-2-3-4\" id=\"feedback\">\n                                <div class=\"ml-auto w-[210px] rounded-lg border border-gray-200 bg-gray-900 p-2.5 text-white shadow-lg\" data-kid=\"1-2-2-2-3-2-3-4-1\">\n                                    <div class=\"flex items-start gap-2\" data-kid=\"1-2-2-2-3-2-3-4-1-1\">\n                                        <div class=\"flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-green-500\" data-kid=\"1-2-2-2-3-2-3-4-1-1-1\">\n                                            <i class=\"h-3 w-3\" data-kid=\"1-2-2-2-3-2-3-4-1-1-1-1\" data-lucide=\"check\">\n                                            </i>\n                                        </div>\n                                        <div class=\"min-w-0\" data-kid=\"1-2-2-2-3-2-3-4-1-1-2\">\n                                            <p class=\"text-[10px] font-semibold\" data-kid=\"1-2-2-2-3-2-3-4-1-1-2-1\">\n                                                Draft saved\n                                            </p>\n                                            <p class=\"mt-0.5 text-[9px] text-gray-300\" data-kid=\"1-2-2-2-3-2-3-4-1-1-2-2\">\n                                                Your inputs are safe offline.\n                                            </p>\n                                        </div>\n                                        <button aria-label=\"Dismiss notification\" class=\"focus-ring ml-auto shrink-0 text-gray-400\" data-kid=\"1-2-2-2-3-2-3-4-1-1-3\" type=\"button\">\n                                            <i class=\"h-3.5 w-3.5\" data-kid=\"1-2-2-2-3-2-3-4-1-1-3-1\" data-lucide=\"x\">\n                                            </i>\n                                        </button>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </article>\n            </div>\n            <section aria-label=\"Shared fallback and implementation notes\" class=\"mt-5 grid gap-5 lg:grid-cols-[1.15fr_.85fr]\" data-kid=\"1-2-2-3\">\n                <div class=\"rounded-2xl border border-gray-200 bg-white p-4 sm:p-5\" data-kid=\"1-2-2-3-1\">\n                    <div class=\"flex items-start justify-between gap-4\" data-kid=\"1-2-2-3-1-1\">\n                        <div data-kid=\"1-2-2-3-1-1-1\">\n                            <p class=\"text-[11px] font-semibold uppercase tracking-[.14em] text-red-600\" data-kid=\"1-2-2-3-1-1-1-1\">\n                                Global fallback / all breakpoints\n                            </p>\n                            <h3 class=\"mt-1 text-sm font-semibold text-gray-900\" data-kid=\"1-2-2-3-1-1-1-2\">\n                                Something unexpected happened\n                            </h3>\n                            <p class=\"mt-1 max-w-xl text-xs leading-5 text-gray-500\" data-kid=\"1-2-2-3-1-1-1-3\">\n                                The page recovered from an unexpected error without exposing internal details. Keep a traceable ID for support.\n                            </p>\n                        </div>\n                        <div class=\"relative flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-red-50 text-red-600\" data-kid=\"1-2-2-3-1-1-2\">\n                            <i class=\"h-5 w-5\" data-kid=\"1-2-2-3-1-1-2-1\" data-lucide=\"triangle-alert\">\n                            </i>\n                            <i class=\"absolute -right-1 -top-1 h-3 w-3 text-red-400\" data-kid=\"1-2-2-3-1-1-2-2\" data-lucide=\"sparkles\">\n                            </i>\n                        </div>\n                    </div>\n                    <div class=\"mt-4 flex flex-col gap-3 rounded-xl border border-red-100 bg-red-50/70 p-3 sm:flex-row sm:items-center sm:justify-between\" data-kid=\"1-2-2-3-1-2\">\n                        <code class=\"rounded-md bg-white px-2.5 py-2 text-[10px] font-medium text-red-700\" data-kid=\"1-2-2-3-1-2-1\">\n                            Error ID: ML-7F3A-0421\n                        </code>\n                        <div class=\"flex flex-wrap gap-2\" data-kid=\"1-2-2-3-1-2-2\">\n                            <button class=\"focus-ring inline-flex items-center justify-center gap-1.5 rounded-md bg-red-600 px-3 py-2 text-[10px] font-semibold text-white\" data-kid=\"1-2-2-3-1-2-2-1\" type=\"button\">\n                                <i class=\"h-3.5 w-3.5\" data-kid=\"1-2-2-3-1-2-2-1-1\" data-lucide=\"refresh-cw\">\n                                </i>\n                                Reload page\n                            </button>\n                            <button class=\"focus-ring inline-flex items-center justify-center gap-1.5 rounded-md border border-gray-300 bg-white px-3 py-2 text-[10px] font-semibold text-gray-700\" data-kid=\"1-2-2-3-1-2-2-2\" type=\"button\">\n                                <i class=\"h-3.5 w-3.5\" data-kid=\"1-2-2-3-1-2-2-2-1\" data-lucide=\"house\">\n                                </i>\n                                Go home\n                            </button>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"rounded-2xl border border-gray-200 bg-white p-4 sm:p-5\" data-kid=\"1-2-2-3-2\">\n                    <div class=\"flex items-center justify-between\" data-kid=\"1-2-2-3-2-1\">\n                        <div data-kid=\"1-2-2-3-2-1-1\">\n                            <p class=\"text-[11px] font-semibold uppercase tracking-[.14em] text-gray-500\" data-kid=\"1-2-2-3-2-1-1-1\">\n                                Behavior contract\n                            </p>\n                            <h3 class=\"mt-1 text-sm font-semibold text-gray-900\" data-kid=\"1-2-2-3-2-1-1-2\">\n                                Responsive, not reduced\n                            </h3>\n                        </div>\n                        <i class=\"h-5 w-5 text-orange-500\" data-kid=\"1-2-2-3-2-1-2\" data-lucide=\"ruler\">\n                        </i>\n                    </div>\n                    <div class=\"mt-4 space-y-2.5 text-xs text-gray-600\" data-kid=\"1-2-2-3-2-2\">\n                        <div class=\"flex gap-2\" data-kid=\"1-2-2-3-2-2-1\">\n                            <i class=\"mt-0.5 h-3.5 w-3.5 text-green-600\" data-kid=\"1-2-2-3-2-2-1-1\" data-lucide=\"check\">\n                            </i>\n                            <span data-kid=\"1-2-2-3-2-2-1-2\">\n                                Skeletons keep final geometry to prevent layout shift.\n                            </span>\n                        </div>\n                        <div class=\"flex gap-2\" data-kid=\"1-2-2-3-2-2-2\">\n                            <i class=\"mt-0.5 h-3.5 w-3.5 text-green-600\" data-kid=\"1-2-2-3-2-2-2-1\" data-lucide=\"check\">\n                            </i>\n                            <span data-kid=\"1-2-2-3-2-2-2-2\">\n                                Retries expose attempt count after automatic backoff.\n                            </span>\n                        </div>\n                        <div class=\"flex gap-2\" data-kid=\"1-2-2-3-2-2-3\">\n                            <i class=\"mt-0.5 h-3.5 w-3.5 text-green-600\" data-kid=\"1-2-2-3-2-2-3-1\" data-lucide=\"check\">\n                            </i>\n                            <span data-kid=\"1-2-2-3-2-2-3-2\">\n                                Toasts are live regions with a visible dismiss action.\n                            </span>\n                        </div>\n                        <div class=\"flex gap-2\" data-kid=\"1-2-2-3-2-2-4\">\n                            <i class=\"mt-0.5 h-3.5 w-3.5 text-green-600\" data-kid=\"1-2-2-3-2-2-4-1\" data-lucide=\"check\">\n                            </i>\n                            <span data-kid=\"1-2-2-3-2-2-4-2\">\n                                Mobile stacks actions; tablet preserves task adjacency.\n                            </span>\n                        </div>\n                    </div>\n                </div>\n            </section>\n        </section>\n    </main>\n    <footer class=\"mx-auto mt-6 flex max-w-[1440px] flex-col gap-2 border-t border-gray-200 pt-4 text-[10px] text-gray-500 sm:flex-row sm:items-center sm:justify-between\" data-kid=\"1-3\">\n        <span data-kid=\"1-3-1\">\n            Metrolane College of Health Sciences and Technology · Result Management\n        </span>\n        <span class=\"flex items-center gap-1.5\" data-kid=\"1-3-2\">\n            <i class=\"h-3.5 w-3.5 text-green-600\" data-kid=\"1-3-2-1\" data-lucide=\"shield-check\">\n            </i>\n            Accessible states are first-class UI\n        </span>\n    </footer>\n</div>\n<script src=\"https://unpkg.com/lucide@0.468.0/dist/umd/lucide.js\">\n</script>\n<script>\n    lucide.createIcons();\n</script>\n",
