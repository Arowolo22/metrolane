g-white shadow-sm\" data-kid=\"1-2-2-2\" data-name=\"tablet view composition card\">\n                <div class=\"flex items-center justify-between border-b border-gray-200 bg-gray-800 px-4 py-3 text-white\" data-kid=\"1-2-2-2-1\" data-name=\"tablet view header\">\n                    <div class=\"flex items-center gap-2\" data-kid=\"1-2-2-2-1-1\" data-name=\"tablet title group\">\n                        <i aria-hidden=\"true\" class=\"h-4 w-4 text-orange-300\" data-kid=\"1-2-2-2-1-1-1\" data-lucide=\"tablet\" data-name=\"tablet icon\">\n                        </i>\n                        <h3 class=\"text-sm font-semibold\" data-kid=\"1-2-2-2-1-1-2\" data-name=\"tablet title\" id=\"tablet-title\">\n                            Tablet\n                        </h3>\n                    </div>\n                    <span class=\"rounded-full bg-white/10 px-2 py-1 text-[10px] font-medium text-gray-300\" data-kid=\"1-2-2-2-1-2\" data-name=\"tablet breakpoint label\">\n                        768–1023 px\n                    </span>\n                </div>\n                <div class=\"space-y-3 bg-gray-50 p-3\" data-kid=\"1-2-2-2-2\" data-name=\"tablet view content\">\n                    <div class=\"flex items-center justify-between rounded-xl border border-gray-200 bg-white p-3\" data-kid=\"1-2-2-2-2-1\" data-name=\"tablet header bar\">\n                        <div class=\"flex items-center gap-2\" data-kid=\"1-2-2-2-2-1-1\" data-name=\"tablet nav group\">\n                            <button aria-label=\"Open sidebar\" class=\"focus-ring flex h-9 w-9 items-center justify-center rounded-lg bg-orange-500 text-white\" data-kid=\"1-2-2-2-2-1-1-1\" data-name=\"open sidebar button\" type=\"button\">\n                                <i aria-hidden=\"true\" class=\"h-4 w-4\" data-kid=\"1-2-2-2-2-1-1-1-1\" data-lucide=\"menu\" data-name=\"menu icon\">\n                                </i>\n                            </button>\n                            <div data-kid=\"1-2-2-2-2-1-1-2\" data-name=\"tablet breadcrumb\">\n                                <p class=\"text-xs font-semibold text-gray-900\" data-kid=\"1-2-2-2-2-1-1-2-1\" data-name=\"tablet title\">\n                                    Calculator\n                                </p>\n                                <p class=\"text-[10px] text-gray-500\" data-kid=\"1-2-2-2-2-1-1-2-2\" data-name=\"tablet subtitle\">\n                                    Generate result\n                                </p>\n                            </div>\n                        </div>\n                        <button aria-label=\"Account menu\" class=\"focus-ring flex h-9 w-9 items-center justify-center rounded-full bg-orange-100 text-[10px] font-bold text-orange-700\" data-kid=\"1-2-2-2-2-1-2\" data-name=\"account button\" type=\"button\">\n                            AO\n                        </button>\n                    </div>\n                    <div aria-live=\"polite\" class=\"flex items-start gap-2 rounded-xl border border-amber-200 bg-amber-50 p-3 text-[10px] text-amber-900\" data-kid=\"1-2-2-2-2-2\" data-name=\"tablet offline alert\" role=\"status\">\n                        <i aria-hidden=\"true\" class=\"mt-0.5 h-4 w-4 shrink-0 text-amber-700\" data-kid=\"1-2-2-2-2-2-1\" data-lucide=\"wifi-off\" data-name=\"wifi off icon\">\n                        </i>\n                        <div class=\"flex-1\" data-kid=\"1-2-2-2-2-2-2\" data-name=\"offline text group\">\n                            <p class=\"font-semibold\" data-kid=\"1-2-2-2-2-2-2-1\" data-name=\"offline title\">\n                                Offline mode\n                            </p>\n                            <p class=\"mt-0.5 leading-4\" data-kid=\"1-2-2-2-2-2-2-2\" data-name=\"offline message\">\n                                We’ll retry the request when connection returns.\n                            </p>\n                        </div>\n                        <button class=\"focus-ring shrink-0