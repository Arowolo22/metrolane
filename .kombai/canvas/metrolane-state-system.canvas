                     Enter at least 6 characters.\n                        </p>\n                        <button class=\"focus-ring mt-3 min-h-9 w-full rounded-lg bg-orange-500 text-[10px] font-semibold text-white hover:bg-orange-600\" data-kid=\"1-2-2-2-2-5-5\" data-name=\"find student button\" type=\"submit\">\n                            Find student\n                        </button>\n                    </form>\n                </div>\n            </article>\n            <!-- Mobile composition -->\n            <article aria-labelledby=\"mobile-title\" class=\"overflow-hidden rounded-2xl border border-gray-300 bg-white shadow-sm\" data-kid=\"1-2-2-3\" data-name=\"mobile view composition card\">\n                <div class=\"flex items-center justify-between border-b border-gray-200 bg-gray-800 px-4 py-3 text-white\" data-kid=\"1-2-2-3-1\" data-name=\"mobile view header\">\n                    <div class=\"flex items-center gap-2\" data-kid=\"1-2-2-3-1-1\" data-name=\"mobile title group\">\n                        <i aria-hidden=\"true\" class=\"h-4 w-4 text-orange-300\" data-kid=\"1-2-2-3-1-1-1\" data-lucide=\"smartphone\" data-name=\"smartphone icon\">\n                        </i>\n                        <h3 class=\"text-sm font-semibold\" data-kid=\"1-2-2-3-1-1-2\" data-name=\"mobile title\" id=\"mobile-title\">\n                            Mobile\n                        </h3>\n                    </div>\n                    <span class=\"rounded-full bg-white/10 px-2 py-1 text-[10px] font-medium text-gray-300\" data-kid=\"1-2-2-3-1-2\" data-name=\"mobile breakpoint label\">\n                        ≤ 767 px\n                    </span>\n                </div>\n                <div class=\"space-y-3 bg-gray-50 p-3\" data-kid=\"1-2-2-3-2\" data-name=\"mobile view content\">\n                    <div class=\"flex items-center justify-between rounded-xl border border-gray-200 bg-white px-3 py-2.5\" data-kid=\"1-2-2-3-2-1\" data-name=\"mobile header bar\">\n                        <button aria-label=\"Open menu\" class=\"focus-ring flex h-9 w-9 items-center justify-center rounded-lg text-gray-600\" data-kid=\"1-2-2-3-2-1-1\" data-name=\"menu button\" type=\"button\">\n                            <i aria-hidden=\"true\" class=\"h-4 w-4\" data-kid=\"1-2-2-3-2-1-1-1\" data-lucide=\"menu\" data-name=\"menu icon\">\n                            </i>\n                        </button>\n                        <p class=\"text-xs font-semibold text-gray-900\" data-kid=\"1-2-2-3-2-1-2\" data-name=\"mobile title\">\n                            Student records\n                        </p>\n                        <button aria-label=\"Notifications\" class=\"focus-ring flex h-9 w-9 items-center justify-center rounded-lg text-gray-600\" data-kid=\"1-2-2-3-2-1-3\" data-name=\"notifications button\" type=\"button\">\n                            <i aria-hidden=\"true\" class=\"h-4 w-4\" data-kid=\"1-2-2-3-2-1-3-1\" data-lucide=\"bell\" data-name=\"bell icon\">\n                            </i>\n                        </button>\n                    </div>\n                    <div aria-live=\"polite\" class=\"rounded-xl border border-amber-200 bg-amber-50 p-3\" data-kid=\"1-2-2-3-2-2\" data-name=\"mobile offline alert\" role=\"status\">\n                        <div class=\"flex items-start gap-2\" data-kid=\"1-2-2-3-2-2-1\" data-name=\"offline icon and text\">\n                            <i aria-hidden=\"true\" class=\"mt-0.5 h-4 w-4 shrink-0 text-amber-700\" data-kid=\"1-2-2-3-2-2-1-1\" data-lucide=\"wifi-off\" data-name=\"wifi off icon\">\n                            </i>\n                            <div class=\"flex-1\" data-kid=\"1-2-2-3-2-2-1-2\" data-name=\"offline text group\">\n                                <p class=\"text-[10px] font-semibold text-amber-900\" data-kid=\"1-2-2-3-2-2-1-2-1\" data-name=\"offline title\">\n                                    You're offline\n                                </p>\n                                <p class=\"mt-0.5 text-[10px] leading-4 text-amber-800\" data-kid=\"1-2-2-3-2-2-1-2-2\" data-name=\"offline message\">\n                                    Some actions are paused.\n                                </p>\n                            </div>\n                        </div>\n                        <button class=\"focus-ring mt-2 min-h-9 w-full rounded-lg border border-amber-300 bg-white text-[10px] font-semibold text-amber-800\" data-kid=\"1-2-2-3-2-2-2\" data-name=\"retry connection button\" type=\"button\">\n                            Retry connection\n                        </button>\n                    </div>\n                    <div class=\"rounded-xl border border-gray-200 bg-white p-3\" data-kid=\"1-2-2-3-2-3\" data-name=\"profile loading card\">\n                        <div class=\"flex items-center gap-2\" data-kid=\"1-2-2-3-2-3-1\" data-name=\"profile loading header\">\n                            <span class=\"state-shimmer h-9 w-9 rounded-full\" data-dynamic=\"true\" data-kid=\"1-2-2-3-2-3-1-1\" data-name=\"shimmer avatar\" data-reason=\"shimmer background animation\">\n                            </span>\n                            <div class=\"flex-1 space-y-1.5\" data-kid=\"1-2-2-3-2-3-1-2\" data-name=\"shimmer text group\">\n                                <span class=\"state-shimmer block h-2.5 w-3/5 rounded\" data-dynamic=\"true\" data-kid=\"1-2-2-3-2-3-1-2-1\" data-name=\"shimmer title\" data-reason=\"shimmer background animation\">\n                                </span>\n                                <span class=\"state-shimmer block h-2 w-2/5 rounded\" data-dynamic=\"true\" data-kid=\"1-2-2-3-2-3-1-2-2\" data-name=\"shimmer subtitle\" data-reason=\"shimmer background animation\">\n                                </span>\n                            </div>\n                        </div>\n                        <div class=\"mt-3 space-y-2\" data-kid=\"1-2-2-3-2-3-2\" data-name=\"skeleton rows\">\n                            <span class=\"state-shimmer block h-10 rounded-lg\" data-dynamic=\"true\" data-kid=\"1-2-2-3-2-3-2-1\" data-name=\"skeleton row 1\" data-reason=\"shimmer background animation\">\n                            </span>\n                            <span class=\"state-shimmer block h-10 rounded-lg\" data-dynamic=\"true\" data-kid=\"1-2-2-3-2-3-2-2\" data-name=\"skeleton row 2\" data-reason=\"shimmer background animation\">\n                            </span>\n                        </div>\n                        <p aria-live=\"polite\" class=\"mt-2 text-[10px] text-gray-500\" data-kid=\"1-2-2-3-2-3-3\" data-name=\"loading message\">\n                            Loading student profile…\n                        </p>\n                    </div>\n                    <div class=\"rounded-xl border border-gray-200 bg-white p-4 text-center\" data-kid=\"1-2-2-3-2-4\" data-name=\"no results card\">\n                        <div class=\"mx-auto flex h-10 w-10 items-center justify-center rounded-xl bg-blue-50 text-blue-600\" data-kid=\"1-2-2-3-2-4-1\" data-name=\"icon container\">\n                            <i aria-hidden=\"true\" class=\"h-5 w-5\" data-kid=\"1-2-2-3-2-4-1-1\" data-lucide=\"search-x\" data-name=\"search x icon\">\n                            </i>\n                        </div>\n                        <p class=\"mt-2 text-xs font-semibold text-gray-900\" data-kid=\"1-2-2-3-2-4-2\" data-name=\"no results title\">\n                            No matches found\n                        </p>\n                        <p class=\"mt-1 text-[10px] leading-4 text-gray-500\" data-kid=\"1-2-2-3-2-4-3\" data-name=\"no results description\">\n                            Try a name or matric number.\n                        </p>\n                        <button class=\"focus-ring mt-3 min-h-9 w-full rounded-lg bg-orange-500 text-[10px] font-semibold text-white\" data-kid=\"1-2-2-3-2-4-4\" data-name=\"clear search button\" type=\"button\">\n                            Clear search\n                        </button>\n                    </div>\n                    <div class=\"rounded-xl border border-blue-200 bg-blue-50 p-3\" data-kid=\"1-2-2-3-2-5\" data-name=\"expired session card\" role=\"alert\">\n                        <div class=\"flex items-start gap-2\" data-kid=\"1-2-2-3-2-5-1\" data-name=\"expired alert header\">\n                            <i aria-hidden=\"true\" class=\"mt-0.5 h-4 w-4 shrink-0 text-blue-700\" data-kid=\"1-2-2-3-2-5-1-1\" data-lucide=\"lock-keyhole\" data-name=\"lock keyhole icon\">\n                            </i>\n                            <div class=\"flex-1\" data-kid=\"1-2-2-3-2-5-1-2\" data-name=\"expired text group\">\n                                <p class=\"text-[10px] font-semibold text-blue-900\" data-kid=\"1-2-2-3-2-5-1-2-1\" data-name=\"expired title\">\n                                    Session expired\n                                </p>\n                                <p class=\"mt-1 text-[10px] leading-4 text-blue-800\" data-kid=\"1-2-2-3-2-5-1-2-2\" data-name=\"expired message\">\n                                    Sign in again to continue.\n                                </p>\n                            </div>\n                        </div>\n                        <button class=\"focus-ring mt-3 min-h-9 w-full rounded-lg border border-blue-300 bg-white text-[10px] font-semibold text-blue-800\" data-kid=\"1-2-2-3-2-5-2\" data-name=\"sign in button\" type=\"button\">\n                            Sign in\n                        </button>\n                    </div>\n                    <div aria-label=\"Mobile notifications\" aria-live=\"polite\" class=\"space-y-2\" data-kid=\"1-2-2-3-2-6\" data-name=\"mobile notifications stack\">\n                        <div class=\"flex items-start gap-2 rounded-lg border border-green-200 bg-green-50 px-3 py-2.5\" data-kid=\"1-2-2-3-2-6-1\" data-name=\"success notification\">\n                            <i aria-hidden=\"true\" class=\"mt-0.5 h-3.5 w-3.5 shrink-0 text-green-700\" data-kid=\"1-2-2-3-2-6-1-1\" data-lucide=\"check\" data-name=\"check icon\">\n                            </i>\n                            <p class=\"flex-1 text-[10px] font-medium text-green-900\" data-kid=\"1-2-2-3-2-6-1-2\" data-name=\"success message\">\n                                Saved successfully\n                            </p>\n                            <button aria-label=\"Dismiss success notification\" class=\"focus-ring text-green-700\" data-kid=\"1-2-2-3-2-6-1-3\" data-name=\"dismiss success button\" type=\"button\">\n                                <i aria-hidden=\"true\" class=\"h-3.5 w-3.5\" data-kid=\"1-2-2-3-2-6-1-3-1\" data-lucide=\"x\" data-name=\"dismiss icon\">\n                                </i>\n                            </button>\n                        </div>\n                    </div>\n                </div>\n            </article>\n        </section>\n        <section class=\"grid gap-5 rounded-2xl border border-gray-200 bg-white p-5 shadow-sm lg:grid-cols-[1fr_1.1fr] lg:p-6\" data-kid=\"1-2-3\" data-name=\"behavioral notes section\">\n            <div data-kid=\"1-2-3-1\" data-name=\"notes text container\">\n                <div class=\"flex items-center gap-2\" data-kid=\"1-2-3-1-1\" data-name=\"notes header\">\n                    <i aria-hidden=\"true\" class=\"h-4 w-4 text-orange-600\" data-kid=\"1-2-3-1-1-1\" data-lucide=\"accessibility\" data-name=\"accessibility icon\">\n                    </i>\n                    <h2 class=\"text-sm font-semibold text-gray-900\" data-kid=\"1-2-3-1-1-2\" data-name=\"notes section title\">\n                        Behavior notes for implementation\n                    </h2>\n                </div>\n                <p class=\"mt-1 text-xs leading-5 text-gray-500\" data-kid=\"1-2-3-1-2\" data-name=\"notes section description\">\n                    The visual footprint changes by breakpoint; the user’s next action stays explicit.\n                </p>\n                <ul class=\"mt-4 space-y-2 text-xs text-gray-600\" data-kid=\"1-2-3-1-3\" data-name=\"notes list\">\n                    <li class=\"flex gap-2\" data-kid=\"1-2-3-1-3-1\" data-name=\"note 1\">\n                        <i aria-hidden=\"true\" class=\"mt-0.5 h-3.5 w-3.5 shrink-0 text-green-600\" data-kid=\"1-2-3-1-3-1-1\" data-lucide=\"check\" data-name=\"check icon\">\n                        </i>\n                        <span data-kid=\"1-2-3-1-3-1-2\" data-name=\"note text\">\n                            Tables become stacked record rows before text becomes unreadably small.\n                        </span>\n                    </li>\n                    <li class=\"flex gap-2\" data-kid=\"1-2-3-1-3-2\" data-name=\"note 2\">\n                        <i aria-hidden=\"true\" class=\"mt-0.5 h-3.5 w-3.5 shrink-0 text-green-600\" data-kid=\"1-2-3-1-3-2-1\" data-lucide=\"check\" data-name=\"check icon\">\n                        </i>\n                        <span data-kid=\"1-2-3-1-3-2-2\" data-name=\"note text\">\n                            Retry and auth actions expand to full-width touch targets on mobile.\n                        </span>\n                    </li>\n                    <li class=\"flex gap-2\" data-kid=\"1-2-3-1-3-3\" data-name=\"note 3\">\n                        <i aria-hidden=\"true\" class=\"mt-0.5 h-3.5 w-3.5 shrink-0 text-green-600\" data-kid=\"1-2-3-1-3-3-1\" data-lucide=\"check\" data-name=\"check icon\">\n                        </i>\n                        <span data-kid=\"1-2-3-1-3-3-2\" data-name=\"note text\">\n                            Error copy explains impact without exposing server details or stack traces.\n                        </span>\n                    </li>\n                </ul>\n            </div>\n            <div aria-live=\"assertive\" class=\"rounded-xl border border-gray-200 bg-gray-50 p-4\" data-kid=\"1-2-3-2\" data-name=\"global error boundary alert\" role=\"alert\">\n                <div class=\"flex items-start gap-3\" data-kid=\"1-2-3-2-1\" data-name=\"global error layout\">\n                    <div class=\"flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-gray-900 text-white\" data-kid=\"1-2-3-2-1-1\" data-name=\"error icon container\">\n                        <i aria-hidden=\"true\" class=\"h-5 w-5\" data-kid=\"1-2-3-2-1-1-1\" data-lucide=\"bug-off\" data-name=\"bug off icon\">\n                        </i>\n                    </div>\n                    <div class=\"min-w-0 flex-1\" data-kid=\"1-2-3-2-1-2\" data-name=\"error message content\">\n                        <p class=\"text-sm font-semibold text-gray-900\" data-kid=\"1-2-3-2-1-2-1\" data-name=\"error boundary title\">\n                            Global error boundary fallback\n                        </p>\n                        <p class=\"mt-1 text-xs leading-5 text-gray-600\" data-kid=\"1-2-3-2-1-2-2\" data-name=\"error boundary description\">\n                            Something unexpected happened. Reload the page or return home; support can use the error ID below.\n                        </p>\n                        <div class=\"mt-3 flex flex-wrap items-center gap-2\" data-kid=\"1-2-3-2-1-2-3\" data-name=\"error actions group\">\n                            <code class=\"rounded-md border border-gray-200 bg-white px-2 py-1 text-[10px] text-gray-600\" data-kid=\"1-2-3-2-1-2-3-1\" data-name=\"error ID code\">\n                                ERR-ML-7F29A1\n                            </code>\n                            <button class=\"focus-ring min-h-9 rounded-lg bg-gray-900 px-3 text-[10px] font-semibold text-white hover:bg-gray-700\" data-kid=\"1-2-3-2-1-2-3-2\" data-name=\"reload page button\" type=\"button\">\n                                Reload page\n                            </button>\n                            <button class=\"focus-ring min-h-9 rounded-lg border border-gray-300 bg-white px-3 text-[10px] font-semibold text-gray-700 hover:bg-gray-50\" data-kid=\"1-2-3-2-1-2-3-3\" data-name=\"go home button\" type=\"button\">\n                                Go home\n                            </button>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n    </main>\n    <script>\n        lucide.createIcons();\n    </script>\n</div>\n",
      "comments": [],
      "created": "2026-08-05T15:47:22.479629+00:00",
      "modified": "2026-08-05T15:50:01.132297+00:00",
      "id": "var_0963bc09ec56"
    },
    "var_d07411641bd1": {
      "type": "variant",
      "label": "Responsive Breakpoint Catalog",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1380,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n  .state-catalog { font-family: Inter, ui-sans-serif, system-ui, sans-serif; }\n  .shimmer { background: linear-gradient(90deg, #f3f4f6 25%, #e5e7eb 50%, #f3f4f6 75%); background-size: 200% 100%; animation: shimmer 1.8s ease-in-out infinite; }\n  @keyframes shimmer { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }\n  .device-grid { grid-template-columns: minmax(0, 1.45fr) minmax(260px, .8fr) minmax(210px, .62fr); }\n  @media (max-width: 1100px) { .device-grid { grid-template-columns: minmax(0, 1fr) minmax(260px, .72fr); } .mobile-device { grid-column: 1 / -1; max-width: 420px; } }\n  @media (max-width: 720px) { .device-grid { grid-template-columns: 1fr; } .desktop-device, .tablet-device, .mobile-device { max-width: none; grid-column: auto; } }\n</style>\n<script src=\"https://unpkg.com/lucide@latest\">\n</script>\n<script>\n    lucide.createIcons();\n</script>\n<div class=\"state-catalog min-h-full bg-gray-50 text-gray-800\" data-kid=\"1\">\n    <header class=\"border-b border-gray-200 bg-white\" data-kid=\"1-1\">\n        <div class=\"mx-auto flex max-w-[1440px] items-center justify-between gap-4 px-5 py-4 sm:px-8\" data-kid=\"1-1-1\">\n            <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"1-1-1-1\">\n                <div aria-hidden=\"true\" class=\"flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-orange-500 text-white shadow-sm\" data-kid=\"1-1-1-1-1\">\n                    <i class=\"h-5 w-5\" data-kid=\"1-1-1-1-1-1\" data-lucide=\"layers-3\">\n                    </i>\n                </div>\n                <div class=\"min-w-0\" data-kid=\"1-1-1-1-2\">\n                    <div class=\"flex items-center gap-2\" data-kid=\"1-1-1-1-2-1\">\n                        <p class=\"truncate text-sm font-semibold text-gray-950\" data-kid=\"1-1-1-1-2-1-1\">\n                            Metrolane\n                        </p>\n                        <span class=\"hidden rounded-full bg-gray-100 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-[.12em] text-gray-500 sm:inline-flex\" data-kid=\"1-1-1-1-2-1-2\">\n                            UI reference\n                        </span>\n                    </div>\n                    <p class=\"truncate text-xs text-gray-500\" data-kid=\"1-1-1-1-2-2\">\n                        Responsive state system · Result management\n                    </p>\n                </div>\n            </div>\n            <div class=\"flex items-center gap-2\" data-kid=\"1-1-1-2\">\n                <span class=\"hidden items-center gap-1.5 rounded-full border border-emerald-200 bg-emerald-50 px-2.5 py-1 text-xs font-medium text-emerald-700 sm:inline-flex\" data-kid=\"1-1-1-2-1\">\n                    <span class=\"h-1.5 w-1.5 rounded-full bg-emerald-500\" data-kid=\"1-1-1-2-1-1\">\n                    </span>\n                    Ready for review\n                </span>\n                <button class=\"inline-flex h-9 items-center gap-2 rounded-lg border border-gray-200 bg-white px-3 text-xs font-semibold text-gray-700 shadow-xs hover:border-gray-300 hover:bg-gray-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-orange-500 focus-visible:ring-offset-2\" data-kid=\"1-1-1-2-2\" type=\"button\">\n                    <i class=\"h-4 w-4 text-gray-500\" data-kid=\"1-1-1-2-2-1\" data-lucide=\"download\">\n                    </i>\n                    <span class=\"hidden sm:inline\" data-kid=\"1-1-1-2-2-2\">\n                        Export spec\n                    </span>\n                </button>\n            </div>\n        </div>\n    </header>\n    <main class=\"mx-auto max-w-[1440px] px-5 py-6 sm:px-8 sm:py-8\" data-kid=\"1-2\">\n        <section class=\"mb-6 flex flex-col justify-between gap-4 lg:flex-row lg:items-end\" data-kid=\"1-2-1\">\n            <div class=\"max-w-2xl\" data-kid=\"1-2-1-1\">\n                <div class=\"mb-3 flex items-center gap-2 text-xs font-semibold uppercase tracking-[.14em] text-orange-600\" data-kid=\"1-2-1-1-1\" data-name=\"section breadcrumb or category label\">\n                    <span class=\"h-px w-5 bg-orange-500\" data-kid=\"1-2-1-1-1-1\" data-name=\"section decorative accent line\">\n                    </span>\n                    Integrated app view\n                </div>\n                <h1 class=\"text-2xl font-bold tracking-tight text-gray-950 sm:text-3xl\" data-kid=\"1-2-1-1-2\" data-name=\"section main heading\">\n                    Resilient states, in context.\n                </h1>\n                <p class=\"mt-2 max-w-xl text-sm leading-6 text-gray-600\" data-kid=\"1-2-1-1-3\" data-name=\"section description text\">\n                    A result-management workspace with offline recovery, loading geometry, empty actions, and safe server fallbacks in the flow of work.\n                </p>\n            </div>\n            <div aria-label=\"Catalog filters\" class=\"flex shrink-0 items-center gap-2 rounded-xl border border-gray-200 bg-white p-1.5 text-xs font-medium shadow-xs\" data-kid=\"1-2-1-2\" role=\"tablist\">\n                <button aria-selected=\"true\" class=\"rounded-lg bg-gray-900 px-3 py-2 text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-orange-500 focus-visible:ring-offset-2\" data-kid=\"1-2-1-2-1\" role=\"tab\" type=\"button\">\n                    All states\n                </button>\n                <button aria-selected=\"false\" class=\"rounded-lg px-3 py-2 text-gray-500 hover:bg-gray-50 hover:text-gray-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-orange-500 focus-visible:ring-offset-2\" data-kid=\"1-2-1-2-2\" role=\"tab\" type=\"button\">\n                    Core flows\n                </button>\n            </div>\n        </section>\n        <section aria-label=\"State system principles\" class=\"mb-6 grid grid-cols-2 gap-3 sm:grid-cols-4\" data-kid=\"1-2-2\">\n            <div class=\"rounded-xl border border-gray-200 bg-white px-4 py-3 shadow-xs\" data-kid=\"1-2-2-1\">\n                <div class=\"mb-2 flex items-center justify-between\" data-kid=\"1-2-2-1-1\">\n                    <span class=\"text-[11px] font-semibold uppercase tracking-wider text-gray-500\" data-kid=\"1-2-2-1-1-1\">\n                        Loading\n                    </span>\n                    <i class=\"h-4 w-4 text-orange-500\" data-kid=\"1-2-2-1-1-2\" data-lucide=\"loader-circle\">\n                    </i>\n                </div>\n                <p class=\"text-sm font-semibold text-gray-950\" data-kid=\"1-2-2-1-2\">\n                    No layout shift\n                </p>\n                <p class=\"mt-1 text-[11px] text-gray-500\" data-kid=\"1-2-2-1-3\">\n                    Skeleton mirrors content\n                </p>\n            </div>\n            <div class=\"rounded-xl border border-gray-200 bg-white px-4 py-3 shadow-xs\" data-kid=\"1-2-2-2\">\n                <div class=\"mb-2 flex items-center justify-between\" data-kid=\"1-2-2-2-1\">\n                    <span class=\"text-[11px] font-semibold uppercase tracking-wider text-gray-500\" data-kid=\"1-2-2-2-1-1\">\n                        Recovery\n                    </span>\n                    <i class=\"h-4 w-4 text-blue-600\" data-kid=\"1-2-2-2-1-2\" data-lucide=\"rotate-cw\">\n                    </i>\n                </div>\n                <p class=\"text-sm font-semibold text-gray-950\" data-kid=\"1-2-2-2-2\">\n                    3 attempts max\n                </p>\n                <p class=\"mt-1 text-[11px] text-gray-500\" data-kid=\"1-2-2-2-3\">\n                    Backoff, then manual retry\n                </p>\n            </div>\n            <div class=\"rounded-xl border border-gray-200 bg-white px-4 py-3 shadow-xs\" data-kid=\"1-2-2-3\">\n                <div class=\"mb-2 flex items-center justify-between\" data-kid=\"1-