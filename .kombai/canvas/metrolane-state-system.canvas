    "var_2cb8cd9ae381": {
      "type": "variant",
      "label": "Responsive Breakpoint Catalog",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 2760,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n  @keyframes state-shimmer {\n    0% { transform: translateX(-120%); opacity: 0; }\n    20% { opacity: .85; }\n    70% { opacity: .35; }\n    100% { transform: translateX(220%); opacity: 0; }\n  }\n  .skeleton { position: relative; overflow: hidden; background: #e5e7eb; }\n  .skeleton::after { content: ''; position: absolute; inset: 0 auto 0 -45%; width: 38%; background: rgba(255,255,255,.62); transform: translateX(-120%); animation: state-shimmer 1.8s ease-in-out infinite; }\n  .device-shell { box-shadow: 0 10px 28px rgba(17,24,39,.07); }\n  .hairline { border-color: #e5e7eb; }\n  .focus-ring:focus-visible { outline: 3px solid rgba(249,115,22,.35); outline-offset: 2px; }\n</style>\n<div class=\"min-h-screen bg-gray-100 px-4 py-5 font-sans text-gray-700 sm:px-6 lg:px-8\" data-kid=\"1\">\n    <header class=\"mx-auto max-w-[1440px]\" data-kid=\"1-1\">\n        <div class=\"flex flex-col gap-4 border-b border-gray-200 pb-5 sm:flex-row sm:items-center sm:justify-between\" data-kid=\"1-1-1\">\n            <div class=\"flex items-center gap-3\" data-kid=\"1-1-1-1\">\n                <div aria-hidden=\"true\" class=\"flex h-10 w-10 items-center justify-center rounded-xl bg-orange-500 text-white shadow-sm\" data-kid=\"1-1-1-1-1\">\n                    <i class=\"h-5 w-5\" data-kid=\"1-1-1-1-1-1\" data-lucide=\"layers-3\">\n                    </i>\n                </div>\n                <div data-kid=\"1-1-1-1-2\">\n                    <p class=\"text-[11px] font-semibold uppercase tracking-[.18em] text-orange-600\" data-kid=\"1-1-1-1-2-1\" data-name=\"header label text\">\n                        METROLANE / UI REFERENCE\n                    </p>\n                    <h1 class=\"text-xl font-semibold tracking-tight text-gray-900 sm:text-2xl\" data-kid=\"1-1-1-1-2-2\" data-name=\"header main title\">\n                        State library for resilient UI\n                    </h1>\n                </div>\n            </div>\n            <div class=\"flex flex-wrap items-center gap-2 text-xs\" data-kid=\"1-1-1-2\">\n                <span class=\"inline-flex items-center gap-1.5 rounded-full border border-green-200 bg-green-50 px-3 py-1.5 font-medium text-green-700\" data-kid=\"1-1-1-2-1\">\n                    <span class=\"h-1.5 w-1.5 rounded-full bg-green-500\" data-kid=\"1-1-1-2-1-1\">\n                    </span>\n                    WCAG AA checked\n                </span>\n                <span class=\"rounded-full border border-gray-200 bg-white px-3 py-1.5 font-medium text-gray-600\" data-kid=\"1-1-1-2-2\">\n                    v1.0 · state contract\n                </span>\n                <button aria-label=\"Open responsive system documentation\" class=\"focus-ring inline-flex items-center gap-1.5 rounded-lg border border-gray-300 bg-white px-3 py-2 font-medium text-gray-700 hover:bg-gray-50\" data-kid=\"1-1-1-2-3\" type=\"button\">\n                    <i class=\"h-3.5 w-3.5\" data-kid=\"1-1-1-2-3-1\" data-lucide=\"book-open\">\n                    </i>\n                    Docs\n                </button>\n            </div>\n        </div>\n        <div class=\"mt-5 grid gap-4 lg:grid-cols-[1fr_auto] lg:items-end\" data-kid=\"1-1-2\">\n            <div data-kid=\"1-1-2-1\">\n                <div class=\"mb-2 flex items-center gap-2 text-xs font-medium text-gray-500\" data-kid=\"1-1-2-1-1\">\n                    <i class=\"h-3.5 w-3.5 text-orange-500\" data-kid=\"1-1-2-1-1-1\" data-lucide=\"scan\">\n                    </i>\n                    One response pattern, three viewport behaviors\n                </div>\n                <p class=\"max-w-3xl text-sm leading-6 text-gray-600\" data-kid=\"1-1-2-1-2\">\n                    The same loading, empty, recoverable error, validation, and feedback rules stay legible as the result-management shell moves from wide dashboard to thumb-first workflow.\n                </p>\n            </div>\n            <div aria-label=\"Breakpoint legend\" class=\"flex items-center gap-2 rounded-xl border border-gray-200 bg-white p-2 text-xs shadow-sm\" data-kid=\"1-1-2-2\">\n                <span class=\"rounded-lg bg-gray-900 px-2.5 py-1.5 font-semibold text-white\" data-kid=\"1-1-2-2-1\">\n                    Desktop\n                </span>\n                <span class=\"rounded-lg bg-gray-100 px-2.5 py-1.5 font-medium text-gray-600\" data-kid=\"1-1-2-2-2\">\n                    Tablet\n                </span>\n                <span class=\"rounded-lg bg-gray-100 px-2.5 py-1.5 font-medium text-gray-600\" data-kid=\"1-1-2-2-3\">\n                    Mobile\n                </span>\n            </div>\n        </div>\n    </header>\n    <main aria-label=\"Responsive breakpoint catalog\" class=\"mx-auto mt-6 grid max-w-[1440px] gap-5 xl:grid-cols-[218px_minmax(0,1fr)]\" data-kid=\"1-2\">\n        <aside class=\"hidden rounded-2xl border border-gray-200 bg-white p-4 xl:block\" data-kid=\"1-2-1\">\n            <div class=\"flex items-center justify-between\" data-kid=\"1-2-1-1\">\n                <p class=\"text-xs font-semibold uppercase tracking-[.14em] text-gray-500\" data-kid=\"1-2-1-1-1\">\n                    State map\n                </p>\n                <i class=\"h-4 w-4 text-gray-400\" data-kid=\"1-2-1-1-2\" data-lucide=\"list-tree\">\n                </i>\n            </div>\n            <nav aria-label=\"State system sections\" class=\"mt-4 space-y-1\" data-kid=\"1-2-1-2\">\n                <a class=\"focus-ring flex items-center justify-between rounded-lg bg-orange-50 px-3 py-2 text-xs font-semibold text-orange-700\" data-kid=\"1-2-1-2-1\" href=\"#loading\">\n                    <span class=\"flex items-center gap-2\" data-kid=\"1-2-1-2-1-1\">\n                        <i class=\"h-3.5 w-3.5\" data-kid=\"1-2-1-2-1-1-1\" data-lucide=\"loader-circle\">\n                        </i>\n                        Loading\n                    </span>\n                    <span data-kid=\"1-2-1-2-1-2\">\n                        01\n                    </span>\n                </a>\n                <a class=\"focus-ring flex items-center justify-between rounded-lg px-3 py-2 text-xs font-medium text-gray-600 hover:bg-gray-50\" data-kid=\"1-2-1-2-2\" href=\"#empty\">\n                    <span class=\"flex items-center gap-2\" data-kid=\"1-2-1-2-2-1\">\n                        <i class=\"h-3.5 w-3.5\" data-kid=\"1-2-1-2-2-1-1\" data-lucide=\"inbox\">\n                        </i>\n                        Empty\n                    </span>\n                    <span data-kid=\"1-2-1-2-2-2\">\n                        02\n                    </span>\n                </a>\n                <a class=\"focus-ring flex items-center justify-between rounded-lg px-3 py-2 text-xs font-medium text-gray-600 hover:bg-gray-50\" data-kid=\"1-2-1-2-3\" href=\"#recoverable\">\n                    <span class=\"flex items-center gap-2\" data-kid=\"1-2-1-2-3-1\">\n                        <i class=\"h-3.5 w-3.5\" data-kid=\"1-2-1-2-3-1-1\" data-lucide=\"rotate-ccw\">\n                        </i>\n                        Recoverable\n                    </span>\n                    <span data-kid=\"1-2-1-2-3-2\">\n                        03\n                    </span>\n                </a>\n                <a class=\"focus-ring flex items-center justify-between rounded-lg px-3 py-2 text-xs font-medium text-gray-600 hover:bg-gray-50\" data-kid=\"1-2-1-2-4\" href=\"#forms\">\n                    <span class=\"flex items-center gap-2\" data-kid=\"1-2-1-2-4-1\">\n                        <i class=\"h-3.5 w-3.5\" data-kid=\"1-2-1-2-4-1-1\" data-lucide=\"square-pen\">\n                        </i>\n                        Forms & auth\n                    </span>\n                    <span data-kid=\"1-2-1-2-4-2\">\n                        04\n                    </span>\n                </a>\n                <a class=\"focus-ring flex items-center justify-between rounded-lg px-3 py-2 text-xs font-medium text-gray-600 hover:bg-gray-50\" data-kid=\"1-2-1-2-5\" href=\"#feedback\">\n                    <span class=\"flex items-center gap-2\" data-kid=\"1-2-1-2-5-1\">\n                        <i class=\"h-3.5 w-3.5\" data-kid=\"1-2-1-2-5-1-1\" data-lucide=\"message-square-more\">\n                        </i>\n                        Feedback\n                    </span>\n                    <span data-kid=\"1-2-1-2-5-2\">\n                        05\n                    </span>\n                </a>\n            </nav>\n            <div class=\"mt-6 border-t border-gray-100 pt-4\" data-kid=\"1-2-1-3\">\n                <p class=\"text-[11px] font-semibold uppercase tracking-[.12em] text-gray-400\" data-kid=\"1-2-1-3-1\">\n                    Every state has\n                </p>\n                <ul class=\"mt-3 space-y-3 text-xs text-gray-600\" data-kid=\"1-2-1-3-2\">\n                    <li class=\"flex gap-2\" data-kid=\"1-2-1-3-2-1\">\n                        <i class=\"mt-0.5 h-3.5 w-3.5 shrink-0 text-green-600\" data-kid=\"1-2-1-3-2-1-1\" data-lucide=\"check-circle-2\">\n                        </i>\n                        <span data-kid=\"1-2-1-3-2-1-2\">\n                            Visible label beyond color\n                        </span>\n                    </li>\n                    <li class=\"flex gap-2\" data-kid=\"1-2-1-3-2-2\">\n                        <i class=\"mt-0.5 h-3.5 w-3.5 shrink-0 text-green-600\" data-kid=\"1-2-1-3-2-2-1\" data-lucide=\"check-circle-2\">\n                        </i>\n                        <span data-kid=\"1-2-1-3-2-2-2\">\n                            Keyboard-safe action\n                        </span>\n                    </li>\n                    <li class=\"flex gap-2\" data-kid=\"1-2-1-3-2-3\">\n                        <i class=\"mt-0.5 h-3.5 w-3.5 shrink-0 text-green-600\" data-kid=\"1-2-1-3-2-3-1\" data-lucide=\"check-circle-2\">\n                        </i>\n                        <span data-kid=\"1-2-1-3-2-3-2\">\n                            aria-live when dynamic\n                        </span>\n                    </li>\n                </ul>\n            </div>\n        </aside>\n        <section aria-labelledby=\"catalog-heading\" class=\"min-w-0\" data-kid=\"1-2-2\">\n            <div class=\"mb-3 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between\" data-kid=\"1-2-2-1\">\n                <div data-kid=\"1-2-2-1-1\">\n                    <h2 class=\"text-sm font-semibold text-gray-900\" data-kid=\"1-2-2-1-1-1\" id=\"catalog-heading\">\n                        Same system, intentional density\n                    </h2>\n                    <p class=\"mt-0.5 text-xs text-gray-500\" data-kid=\"1-2-2-1-1-2\">\n                        Desktop preserves context · tablet prioritizes task · mobile preserves recovery\n                    </p>\n                </div>\n                <div aria-live=\"polite\" class=\"inline-flex w-fit items-center gap-2 rounded-lg border border-blue-200 bg-blue-50 px-3 py-2 text-xs text-blue-800\" data-kid=\"1-2-2-1-2\" role=\"status\">\n                    <i class=\"h-3.5 w-3.5\" data-kid=\"1-2-2-1-2-1\" data-lucide=\"info\">\n                    </i>\n                    <span data-kid=\"1-2-2-1-2-2\">\n                        Live preview · data refresh paused\n                    </span>\n                </div>\n            </div>\n            <div class=\"grid items-start gap-5 2xl:grid-cols-3\" data-kid=\"1-2-2-2\">\n                <!-- Desktop composition -->\n                <article aria-labelledby=\"desktop-title\" class=\"device-shell rounded-[20px] border border-gray-300 bg-gray-200 p-2\" data-kid=\"1-2-2-2-1\">\n                    <div class=\"flex items-center justify-between px-2 pb-2 text-[10px] font-semibold uppercase tracking-[.12em] text-gray-500\" data-kid=\"1-2-2-2-1-1\">\n                        <span data-kid=\"1-2-2-2-1-1-1\" id=\"desktop-title\">\n                            Desktop / 1280\n                        </span>\n                        <span class=\"flex items-center gap-1\" data-kid=\"1-2-2-2-1-1-2\">\n                            <i class=\"h-3 w-3\" data-kid=\"1-2-2-2-1-1-2-1\" data-lucide=\"monitor\">\n                            </i>\n                            wide context\n                        </span>\n                    </div>\n                    <div class=\"overflow-hidden rounded-2xl border border-gray-200 bg-gray-50\" data-kid=\"1-2-2-2-1-2\">\n                        <div class=\"flex h-11 items-center justify-between border-b border-gray-200 bg-white px-3\" data-kid=\"1-2-2-2-1-2-1\">\n                            <div class=\"flex items-center gap-2\" data-kid=\"1-2-2-2-1-2-1-1\">\n                                <div class=\"flex h-6 w-6 items-center justify-center rounded-md bg-orange-500 text-white\" data-kid=\"1-2-2-2-1-2-1-1-1\">\n                                    <i class=\"h-3.5 w-3.5\" data-kid=\"1-2-2-2-1-2-1-1-1-1\" data-lucide=\"graduation-cap\">\n                                    </i>\n                                </div>\n                                <span class=\"text-xs font-semibold text-gray-900\" data-kid=\"1-2-2-2-1-2-1-1-2\">\n                                    Metrolane\n                                </span>\n                            </div>\n                            <div class=\"hidden items-center gap-1.5 md:flex\" data-kid=\"1-2-2-2-1-2-1-2\">\n                                <div class=\"h-7 w-28 rounded-md border border-gray-200 bg-gray-50\" data-kid=\"1-2-2-2-1-2-1-2-1\">\n                                </div>\n                                <button aria-label=\"Desktop notifications\" class=\"focus-ring flex h-7 w-7 items-center justify-center rounded-md text-gray-500 hover:bg-gray-100\" data-kid=\"1-2-2-2-1-2-1-2-2\" type=\"button\">\n                                    <i class=\"h-3.5 w-3.5\" data-kid=\"1-2-2-2-1-2-1-2-2-1\" data-lucide=\"bell\">\n                                    </i>\n                                </button>\n                                <div class=\"h-7 w-7 rounded-full bg-orange-100\" data-kid=\"1-2-2-2-1-2-1-2-3\">\n                                </div>\n                            </div>\n                        </div>\n                        <div aria-live=\"polite\" class=\"border-b border-amber-200 bg-amber-50 px-3 py-2\" data-kid=\"1-2-2-2-1-2-2\">\n                            <div class=\"flex items-center gap-2 text-[10px] text-amber-800\" data-kid=\"1-2-2-2-1-2-2-1\">\n                                <i class=\"h-3.5 w-3.5 shrink-0\" data-kid=\"1-2-2-2-1-2-2-1-1\" data-lucide=\"wifi-off\">\n                                </i>\n                                <span data-kid=\"1-2-2-2-1-2-2-1-2\">\n                                    <strong class=\"font-semibold\" data-kid=\"1-2-2-2-1-2-2-1-2-1\">\n                                        You're offline.\n                                    </strong>\n                                    Changes will sync when connection returns.\n                                </span>\n                                <button class=\"focus-ring ml-auto rounded-md border border-amber-300 bg-white px-2 py-1 font-semibold text-amber-800\" data-kid=\"1-2-2-2-1-2-2-1-3\" type=\"button\">\n                                    Retry\n                                </button>\n                            </div>\n                        </div>\n                        <div class=\"p-3\" data-kid=\"1-2-2-2-1-2-3\">\n                            <div class=\"flex items-start justify-between gap-3\" data-kid=\"1-2-2-2-1-2-3-1\">\n                                <div data-kid=\"1-2-2-2-1-2-3-1-1\">\n                                    <p class=\"text-[10px] font-semibold uppercase tracking-[.12em] text-orange-600\" data-kid=\"1-2-2-2-1-2-3-1-1-1\">\n                                        Student records\n                                    </p>\n                                    <h3 class=\"mt-1 text-base font-semibold text-gray-900\" data-kid=\"1-2-2-2-1-2-3-1-1-2\">\n                                        Overview\n                                    </h3>\n                                    <p class=\"mt-0.5 text-[10px] text-gray-500\" data-kid=\"1-2-2-2-1-2-3-1-1-3\">\n                                        Updated just now · list refresh pending\n                                    </p>\n                                </div>\n                                <button class=\"focus-ring rounded-md bg-orange-500 px-2.5 py-1.5 text-[10px] font-semibold text-white shadow-sm hover:bg-orange-600\" data-kid=\"1-2-2-2-1-2-3-1-2\" type=\"button\">\n                                    Add student\n                                </button>\n                            </div>\n                            <div aria-busy=\"true\" aria-label=\"Dashboard cards loading\" class=\"mt-3 grid grid-cols-3 gap-2\" data-kid=\"1-2-2-2-1-2-3-2\" id=\"loading\">\n                                <div class=\"rounded-lg border border-gray-200 bg-white p-2.5\" data-kid=\"1-2-2-2-1-2-3-2-1\">\n                                    <div class=\"skeleton h-2.5 w-16 rounded\" data-kid=\"1-2-2-2-1-2-3-2-1-1\">\n                                    </div>\n                                    <div class=\"skeleton mt-2 h-5 w-12 rounded\" data-kid=\"1-2-2-2-1-2-3-2-1-2\">\n                                    </div>\n                                    <div class=\"skeleton mt-2 h-2 w-20 rounded\" data-kid=\"1-2-2-2-1-2-3-2-1-3\">\n                                    </div>\n                                </div>\n                                <div class=\"rounded-lg border border-gray-200 bg-white p-2.5\" data-kid=\"1-2-2-2-1-2-3-2-2\">\n                                    <div class=\"skeleton h-2.5 w-16 rounded\" data-kid=\"1-2-2-2-1-2-3-2-2-1\">\n                                    </div>\n                                    <div class=\"skeleton mt-2 h-5 w-12 rounded\" data-kid=\"1-2-2-2-1-2-3-2-2-2\">\n                                    </div>\n                                    <div class=\"skeleton mt-2 h-2 w-20 rounded\" data-kid=\"1-2-2-2-1-2-3-2-2-3\">\n                                    </div>\n                                </div>\n                                <div class=\"rounded-lg border border-gray-200 bg-white p-2.5\" data-kid=\"1-2-2-2-1-2-3-2-3\">\n                                    <div class=\"skeleton h-2.5 w-16 rounded\" data-kid=\"1-2-2-2-1-2-3-2-3-1\">\n                                    </div>\n                                    <div class=\"skeleton mt-2 h-5 w-12 rounded\" data-kid=\"1-2-2-2-1-2-3-2-3-2\">\n                                    </div>\n                                    <div class=\"skeleton mt-2 h-2 w-20 rounded\" data-kid=\"1-2-2-2-1-2-3-2-3-3\">\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"mt-3 grid gap-3 lg:grid-cols-[1.45fr_1fr]\" data-kid=\"1-2-2-2-1-2-3-3\">\n                                <div class=\"rounded-lg border border-gray-200 bg-white p-2.5\" data-kid=\"1-2-2-2-1-2-3-3-1\">\n                                    <div class=\"flex items-center justify-between\" data-kid=\"1-2-2-2-1-2-3-3-1-1\">\n                                        <h4 class=\"text-[10px] font-semibold text-gray-900\" data-kid=\"1-2-2-2-1-2-3-3-1-1-1\">\n                                            Recent calculations\n                                        </h4>\n                                        <span class=\"text-[9px] text-gray-400\" data-kid=\"1-2-2-2-1-2-3-3-1-1-2\">\n                                            Loading list\n                                        </span>\n                                    </div>\n                                    <div class=\"mt-2 overflow-hidde