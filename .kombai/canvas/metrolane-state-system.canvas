p class=\"mt-1 text-[9px] text-gray-500\" data-kid=\"1-2-4-3-2-1-3-1-1-1-2\">\n                                            0 records match “Arowolo”\n                                        </p>\n                                    </div>\n                                    <div class=\"flex h-8 w-8 items-center justify-center rounded-full bg-gray-50 text-gray-400\" data-kid=\"1-2-4-3-2-1-3-1-1-2\">\n                                        <i class=\"h-4 w-4\" data-kid=\"1-2-4-3-2-1-3-1-1-2-1\" data-lucide=\"search-x\">\n                                        </i>\n                                    </div>\n                                </div>\n                                <div class=\"mt-3 border-t border-gray-100 pt-3 text-center\" data-kid=\"1-2-4-3-2-1-3-1-2\">\n                                    <i class=\"mx-auto h-6 w-6 text-gray-400\" data-kid=\"1-2-4-3-2-1-3-1-2-1\" data-lucide=\"file-search-2\">\n                                    </i>\n                                    <p class=\"mt-2 text-[10px] font-semibold text-gray-800\" data-kid=\"1-2-4-3-2-1-3-1-2-2\">\n                                        No students found\n                                    </p>\n                                    <p class=\"mx-auto mt-1 max-w-[170px] text-[9px] leading-3.5 text-gray-500\" data-kid=\"1-2-4-3-2-1-3-1-2-3\">\n                                        Try a different name or clear the search.\n                                    </p>\n                                    <button class=\"mt-2 rounded-md bg-gray-900 px-3 py-1.5 text-[9px] font-semibold text-white hover:bg-gray-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-orange-500\" data-kid=\"1-2-4-3-2-1-3-1-2-4\" type=\"button\">\n                                        Clear search\n                                    </button>\n                                </div>\n                            </div>\n                            <div aria-live=\"assertive\" class=\"rounded-lg border border-red-200 bg-red-50 p-3\" data-kid=\"1-2-4-3-2-1-3-2\" role=\"alert\">\n                                <div class=\"flex items-start gap-2\" data-kid=\"1-2-4-3-2-1-3-2-1\">\n                                    <i class=\"mt-0.5 h-3.5 w-3.5 shrink-0 text-red-600\" data-kid=\"1-2-4-3-2-1-3-2-1-1\" data-lucide=\"server-off\">\n                                    </i>\n                                    <div class=\"min-w-0 flex-1\" data-kid=\"1-2-4-3-2-1-3-2-1-2\">\n                                        <p class=\"text-[10px] font-semibold text-red-900\" data-kid=\"1-2-4-3-2-1-3-2-1-2-1\">\n                                            Something went wrong\n                                        </p>\n                                        <p class=\"mt-1 text-[9px] leading-3.5 text-red-800\" data-kid=\"1-2-4-3-2-1-3-2-1-2-2\">\n                                            We couldn’t load this view.\n                                        </p>\n                                        <button class=\"mt-2 w-full rounded-md bg-red-600 py-1.5 text-[9px] font-semibold text-white hover:bg-red-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-600 focus-visible:ring-offset-2\" data-kid=\"1-2-4-3-2-1-3-2-1-2-3\" type=\"button\">\n                                            Try again · 3/3\n                                        </button>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"rounded-lg border border-orange-200 bg-orange-50 p-3\" data-kid=\"1-2-4-3-2-1-3-3\">\n                                <div class=\"flex items-start gap-2\" data-kid=\"1-2-4-3-2-1-3-3-1\">\n                                    <i class=\"mt-0.5 h-3.5 w-3.5 shrink-0 text-orange-700\" data-kid=\"1-2-4-3-2-1-3-3-1-1\" data-lucide=\"file-warning\">\n                                    </i>\n                                    <div data-kid=\"1-2-4-3-2-1-3-3-1-2\">\n                                        <p class=\"text-[10px] font-semibold text-orange-900\" data-kid=\"1-2-4-3-2-1-3-3-1-2-1\">\n                                            Validation needed\n                                        </p>\n                                        <p class=\"mt-1 text-[9px] leading-3.5 text-orange-800\" data-kid=\"1-2-4-3-2-1-3-3-1-2-2\">\n                                            Enter a matric number before generating.\n                                        </p>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <div aria-live=\"polite\" class=\"mt-2 rounded-lg border border-gray-200 bg-white p-2.5\" data-dynamic=\"true\" data-kid=\"1-2-4-3-2-2\" data-name=\"notification alert\" data-reason=\"element injected/updated by state management script\">\n                        <div class=\"flex items-start gap-2\" data-kid=\"1-2-4-3-2-2-1\">\n                            <div class=\"flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-700\" data-kid=\"1-2-4-3-2-2-1-1\">\n                                <i class=\"h-3.5 w-3.5\" data-kid=\"1-2-4-3-2-2-1-1-1\" data-lucide=\"check\">\n                                </i>\n                            </div>\n                            <div class=\"min-w-0 flex-1\" data-kid=\"1-2-4-3-2-2-1-2\">\n                                <p class=\"text-[10px] font-semibold text-gray-900\" data-kid=\"1-2-4-3-2-2-1-2-1\">\n                                    Draft saved\n                                </p>\n                                <p class=\"mt-0.5 text-[9px] text-gray-500\" data-kid=\"1-2-4-3-2-2-1-2-2\">\n                                    We’ll sync it when you’re back online.\n                                </p>\n                            </div>\n                            <button aria-label=\"Dismiss notification\" class=\"text-gray-400 hover:text-gray-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-orange-500\" data-kid=\"1-2-4-3-2-2-1-3\" type=\"button\">\n                                <i class=\"h-3.5 w-3.5\" data-kid=\"1-2-4-3-2-2-1-3-1\" data-lucide=\"x\">\n                                </i>\n                            </button>\n                        </div>\n                    </div>\n                </div>\n            </article>\n        </section>\n        <section aria-label=\"Shared failure patterns\" class=\"mt-6 grid gap-4 lg:grid-cols-[1.1fr_.9fr]\" data-kid=\"1-2-5\">\n            <div class=\"rounded-2xl border border-gray-200 bg-white p-4 shadow-xs sm:p-5\" data-kid=\"1-2-5-1\">\n                <div class=\"mb-4 flex items-start justify-between gap-4\" data-kid=\"1-2-5-1-1\">\n                    <div data-kid=\"1-2-5-1-1-1\">\n                        <div class=\"mb-2 flex items-center gap-2\" data-kid=\"1-2-5-1-1-1-1\">\n                            <span class=\"flex h-6 w-6 items-center justify-center rounded-md bg-gray-900 text-white\" data-kid=\"1-2-5-1-1-1-1-1\">\n                                <i class=\"h-3.5 w-3.5\" data-kid=\"1-2-5-1-1-1-1-1-1\" data-lucide=\"shield-alert\">\n                                </i>\n                            </span>\n                            <h2 class=\"text-sm font-semibold text-gray-950\" data-kid=\"1-2-5-1-1-1-1-2\">\n                                Global error boundary\n                            </h2>\n                        </div>\n                        <p class=\"max-w-lg text-xs leading-5 text-gray-500\" data-kid=\"1-2-5-1-1-1-2\">\n                            A calm fallback replaces a blank screen and gives support a safe diagnostic handle.\n                        </p>\n                    </div>\n                    <span class=\"rounded-full border border-red-200 bg-red-50 px-2 py-1 text-[10px] font-semibold text-red-700\" data-kid=\"1-2-5-1-1-2\">\n                        Unexpected error\n                    </span>\n                </div>\n                <div class=\"flex flex-col gap-4 rounded-xl border border-red-200 bg-red-50/60 p-4 sm:flex-row sm:items-center\" data-kid=\"1-2-5-1-2\">\n                    <div class=\"flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-white text-red-600 shadow-xs\" data-kid=\"1-2-5-1-2-1\">\n                        <i class=\"h-6 w-6\" data-kid=\"1-2-5-1-2-1-1\" data-lucide=\"triangle-alert\">\n                        </i>\n                    </div>\n                    <div class=\"min-w-0 flex-1\" data-kid=\"1-2-5-1-2-2\">\n                        <h3 class=\"text-sm font-semibold text-red-950\" data-kid=\"1-2-5-1-2-2-1\">\n                            We hit an unexpected snag\n                        </h3>\n                        <p class=\"mt-1 text-xs leading-5 text-red-800\" data-kid=\"1-2-5-1-2-2-2\">\n                            Your work is safe. Reload the page or return home while we investigate.\n                        </p>\n                        <p class=\"mt-2 font-mono text-[10px] text-red-700\" data-kid=\"1-2-5-1-2-2-3\">\n                            Error ID: ML-7F3K-29Q\n                        </p>\n                    </div>\n                    <div class=\"flex shrink-0 flex-wrap gap-2\" data-kid=\"1-2-5-1-2-3\">\n                        <button class=\"inline-flex items-center gap-1.5 rounded-lg bg-red-600 px-3 py-2 text-xs font-semibold text-white hover:bg-red-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-600 focus-visible:ring-offset-2\" data-kid=\"1-2-5-1-2-3-1\" type=\"button\">\n                            <i class=\"h-3.5 w-3.5\" data-kid=\"1-2-5-1-2-3-1-1\" data-lucide=\"refresh-cw\">\n                            </i>\n                            Reload page\n                        </button>\n                        <button class=\"inline-flex items-center gap-1.5 rounded-lg border border-red-300 bg-white px-3 py-2 text-xs font-semibold text-red-800 hover:bg-red-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-600 focus-visible:ring-offset-2\" data-kid=\"1-2-5-1-2-3-2\" type=\"button\">\n                            <i class=\"h-3.5 w-3.5\" data-kid=\"1-2-5-1-2-3-2-1\" data-lucide=\"house\">\n                            </i>\n                            Go home\n                        </button>\n                    </div>\n                </div>\n            </div>\n            <div class=\"rounded-2xl border border-gray-200 bg-white p-4 shadow-xs sm:p-5\" data-kid=\"1-2-5-2\">\n                <div class=\"mb-4 flex items-start justify-between\" data-kid=\"1-2-5-2-1\">\n                    <div data-kid=\"1-2-5-2-1-1\">\n                        <div class=\"mb-2 flex items-center gap-2\" data-kid=\"1-2-5-2-1-1-1\">\n                            <i class=\"h-4 w-4 text-orange-600\" data-kid=\"1-2-5-2-1-1-1-1\" data-lucide=\"clipboard-check\">\n                            </i>\n                            <h2 class=\"text-sm font-semibold text-gray-950\" data-kid=\"1-2-5-2-1-1-1-2\">\n                                Inline validation\n                            </h2>\n                        </div>\n                        <p class=\"text-xs text-gray-500\" data-kid=\"1-2-5-2-1-1-2\">\n                            Preserve input and focus the first invalid field.\n                        </p>\n                    </div>\n                    <span class=\"text-[10px] font-medium text-gray-500\" data-kid=\"1-2-5-2-1-2\">\n                        2 errors\n                    </span>\n                </div>\n                <form aria-label=\"Generate result form\" class=\"space-y-3\" data-kid=\"1-2-5-2-2\">\n                    <label class=\"block\" data-kid=\"1-2-5-2-2-1\">\n                        <span class=\"mb-1.5 block text-[11px] font-semibold text-gray-700\" data-kid=\"1-2-5-2-2-1-1\">\n                            Matric number\n                            <span class=\"text-red-600\" data-kid=\"1-2-5-2-2-1-1-1\">\n                                *\n                            </span>\n                        </span>\n                        <div class=\"relative\" data-kid=\"1-2-5-2-2-1-2\">\n                            <input aria-describedby=\"matric-error\" aria-invalid=\"true\" class=\"h-9 w-full rounded-lg border border-red-400 bg-red-50/40 px-3 pr-8 text-xs text-gray-900 outline-none focus-visible:ring-2 focus-visible:ring-orange-500\" data-kid=\"1-2-5-2-2-1-2-1\" readonly=\"\" type=\"text\" value=\"MLS-24\"/>\n                            <i class=\"absolute right-2.5 top-1/2 h-3.5 w-3.5 -translate-y-1/2 text-red-600\" data-kid=\"1-2-5-2-2-1-2-2\" data-lucide=\"circle-alert\">\n                            </i>\n                        </div>\n                        <span class=\"mt-1 flex items-center gap-1 text-[10px] text-red-700\" data-kid=\"1-2-5-2-2-1-3\" id=\"matric-error\">\n                            <i class=\"h-3 w-3\" data-kid=\"1-2-5-2-2-1-3-1\" data-lucide=\"info\">\n                            </i>\n                            Use 8–12 characters.\n                        </span>\n                    </label>\n                    <label class=\"block\" data-kid=\"1-2-5-2-2-2\">\n                        <span class=\"mb-1.5 block text-[11px] font-semibold text-gray-700\" data-kid=\"1-2-5-2-2-2-1\">\n                            Current GPA\n                        </span>\n                        <input class=\"h-9 w-full rounded-lg border border-gray-200 bg-white px-3 text-xs text-gray-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-orange-500\" data-kid=\"1-2-5-2-2-2-2\" readonly=\"\" type=\"text\" value=\"4.82\"/>\n                        <span class=\"mt-1 block text-[10px] text-gray-500\" data-kid=\"1-2-5-2-2-2-3\">\n                            Optional · validated on blur\n                        </span>\n                    </label>\n                    <button class=\"flex h-9 w-full items-center justify-center gap-1.5 rounded-lg bg-orange-500 text-xs font-semibold text-white hover:bg-orange-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-orange-500 focus-visible:ring-offset-2\" data-kid=\"1-2-5-2-2-3\" type=\"button\">\n                        <i class=\"h-3.5 w-3.5\" data-kid=\"1-2-5-2-2-3-1\" data-lucide=\"sparkles\">\n                        </i>\n                        Generate result\n                    </button>\n                </form>\n            </div>\n        </section>\n        <footer class=\"mt-6 flex flex-col gap-2 border-t border-gray-200 pt-4 text-[10px] text-gray-500 sm:flex-row sm:items-center sm:justify-between\" data-kid=\"1-2-6\">\n            <p class=\"flex items-center gap-1.5\" data-kid=\"1-2-6-1\">\n                <i class=\"h-3.5 w-3.5 text-orange-500\" data-kid=\"1-2-6-1-1\" data-lucide=\"command\">\n                </i>\n                State primitives are reusable across calculator, records, settings, and support.\n            </p>\n            <p data-kid=\"1-2-6-2\">\n                Focus rings · aria-live · visible recovery copy · no raw server errors\n            </p>\n        </footer>\n    </main>\n</div>\n",
